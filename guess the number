import numpy as np
def stop_errors(a):
    try:
        a = int(a)
        return a
    except ValueError:
        print("Error. Enter whole numbers only")
secret_number = np.random.randint(1,101)
guess = None
print("Guess the number from 1 to 100. You have 6 tries.")
for i in range(6):
    while guess == None:
        guess = stop_errors(input("Your guess: "))
    if secret_number == guess:
        print("Correct! You win!")
        break
    else:
        if secret_number > guess:
            print("Bigger!")
        else:
            print("Smaller!")
        guess = None
print("The secret number was",secret_number)

