def error_handle(a):
    try:
        a = int(a)
        return a
    except ValueError:
        print("Error. Please provide whole numbers only")
num1 = None
num2 = None
print("Create a fibonacci sequence by providing the first 2 terms")
while num1 == None:
    num1 = error_handle(input("Enter the first number: "))
while num2 == None:    
    num2 = error_handle(input("Enter the second number: "))
print(f"{num1},")
print(f"{num2},")
for i in range(10):
    num1 = num1 + num2
    print(f"{num1},")
    num2 = num1 + num2
    print(f"{num2},")

